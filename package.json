{
  "name": "onde-passa",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply onde-passa --local",
    "scrape:local": "curl -fsS http://localhost:8787/__scheduled",
    "deploy": "wrangler deploy",
    "check:og": "scripts/check-og.sh",
    "check:bundle": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261031.1",
    "ical.js": "2.2.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261023.1": true
  },
  "dependencies": {
    "workers-og": "0.0.27"
  }
}
